# ==============================================================================
# Advanced AI-Powered Fake News Detection System - Configuration
# Copy this file to .env and fill in your keys (optional).
# The system works fully offline with local NLP even without external API keys.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Google Gemini API Key (Optional, enhances deep claim analysis with LLM)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Fact Check Tools API Key (Optional, enhances fact-checker database lookups)
# Get a key from Google Cloud Console (Enable Fact Check Tools API)
GOOGLE_FACTCHECK_API_KEY=

# Database Connection (Defaults to local SQLite database fake_news.db)
DATABASE_URL=sqlite:///./fake_news.db

# Request Timeout (seconds)
REQUEST_TIMEOUT=10
