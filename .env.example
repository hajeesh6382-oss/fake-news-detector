# ==============================================================================
# VERITAS AI – ENTERPRISE V2.0 CONFIGURATION
# Copy this file to .env and configure your keys.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Google Gemini API Key (Claim Extraction & Fact Analysis)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# NewsAPI Key (Optional, enhances multi-source news queries)
# Get a key at: https://newsapi.org/
NEWS_API_KEY=

# Search Provider API Key (Optional, enhances Google News/Web queries)
SEARCH_API_KEY=

# Google Fact Check Tools API Key (Optional)
GOOGLE_FACTCHECK_API_KEY=

# Database Connection (Defaults to local SQLite database fake_news.db)
DATABASE_URL=sqlite:///./fake_news.db

# Request Timeout (seconds)
REQUEST_TIMEOUT=10
